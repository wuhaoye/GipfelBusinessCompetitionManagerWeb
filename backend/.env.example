# ============================================================
# Gipfel 商赛系统 — Django 服务端环境变量配置
# 复制本文件为 .env 并按需修改：copy .env.example .env
# ============================================================

# 服务端监听端口（默认 8000）
# 单一真源：① 用 `python manage.py rundaphne` 启动时会按此端口绑定 daphne；
#          ② 经 /api/version 下发，前端「系统设置 → 后端管理」跳转按钮据此拼后台地址。
# 改端口只需改这里并重启，无需动前端代码。
PORT=8000

# 【必填】JWT 签名密钥 —— 未配置时服务端直接拒绝启动（fail-fast）
# 留空即可：deploy-linux.sh 首次部署会自动生成强随机值写入 .env。
# 本地手动开发请自行填入：openssl rand -hex 32（切勿使用下方被注释的弱值）
JWT_SECRET=""

# 【生产建议】Django 自身 SECRET_KEY（session / CSRF 签名用，与 JWT 密钥分离）
# 未设置时回退 JWT_SECRET（迁移期兼容）。生产请独立配置：openssl rand -hex 32
# 注意：更换后现有 session / CSRF cookie 失效（用户需重新登录），择机轮换。
# DJANGO_SECRET_KEY=""

# 【可选】可信代理地址（逗号分隔精确 IP，默认仅回环 127.0.0.1 / ::1）
# 仅当请求来自此集合内的 REMOTE_ADDR 时才信任其 X-Real-IP（取客户端真实 IP，
# 用于登录限速等按 IP 防护）。标准 nginx 反代部署（daphne 绑 127.0.0.1）无需设置；
# 仅当代理与本机非回环直连（如容器网络）时才需追加代理 IP。
# TRUSTED_PROXIES="10.0.0.5,192.168.1.10"

# 默认超级管理员（首次 migrate 自动写入；业务超管 + Django 后台 /admin 超管共用同一凭据）
# 仅当库中尚无该用户名时创建；已存在则跳过，不覆盖。
# 首次登录后系统强制要求修改密码（must_change_password=true）
# SEED_ADMIN_USERNAME="admin"
# SEED_ADMIN_EMAIL="admin@example.com"
# 未配置时自动生成强随机密码（deploy-linux.sh 也会自动生成）
# SEED_ADMIN_PASSWORD=""

# JWT 有效期（默认 24h，支持 ms 库格式：1h / 7d / 30m）
JWT_EXPIRES_IN="24h"

# JWT 签发者声明（默认 gipfel-competition）
JWT_ISSUER="gipfel-competition"

# JWT 受众声明（默认 gipfel-competition-client）
JWT_AUDIENCE="gipfel-competition-client"

# 日志级别：ERROR / WARNING / INFO / DEBUG（默认 INFO）
LOG_LEVEL="INFO"

# 日志文件输出目录（相对 backend/，默认 ./logs）
LOG_DIR="./logs"

# CORS 允许的来源（可选）
# 未设置：仅允许本地/私网来源（localhost、RFC1918、file://、app://）反射并带凭据
# 设为具体域名（逗号分隔）：严格白名单，且该来源会带凭据（Access-Control-Allow-Credentials）
# 设为 *：同「未设置」行为（不放行公网）
# CORS_ORIGIN="https://your-domain.com"

# Django ALLOWED_HOSTS（Host 头白名单，逗号分隔）
# 【生产必填】设置为公网域名或服务器 IP，例如 "example.com,www.example.com,1.2.3.4"
# 未设置时仅回环地址（127.0.0.1/localhost）可达，公网访问会被拒（400），并消除 Host 投毒风险
DJANGO_ALLOWED_HOSTS="127.0.0.1,localhost,::1"

# Django CSRF Origin 白名单（逗号分隔，scheme://host[:port] 显式格式；生产按域名填写）
# /admin 登录等带 Origin 的 POST 必须命中，否则 403；本地回环 origin 已内置默认放行
# DJANGO_CSRF_TRUSTED_ORIGINS="https://your-domain.com"

# 上传文件根目录（默认 ./uploads）
UPLOAD_DIR="./uploads"

# ============================================================
# 快照与回退（apps.snapshots）
# ============================================================
# 快照归档目录（默认 backend/snapshots）：每份快照一个子目录
# （manifest.json + tables/*.jsonl.gz + files/）。生产环境该目录必须在
# systemd 的 ReadWritePaths 白名单内（deploy/gipfel.service 已包含），
# 且被升级脚本 --exclude snapshots 保护，不会被 rsync --delete 清掉。
# SNAPSHOT_DIR="./snapshots"

# 门禁状态进程内缓存秒数（默认 1）。多进程部署时其它进程的暂停/恢复最多滞后这么久。
# SNAPSHOT_GATE_CACHE_SECONDS=1

# 强制暂停时等待「在途写请求」排空的上限（秒，默认 10）。
# 超时则暂停失败并自动恢复运行（数据不变），由管理员稍后重试。
# SNAPSHOT_DRAIN_TIMEOUT=10

# 「回退中」状态的兜底 TTL（秒，默认 900）：进程异常退出时不至于永久停在回退态。
# SNAPSHOT_RESTORE_TTL_SECONDS=900

# 手动「强制暂停」的默认 TTL（秒，默认 0 = 不自动恢复，需管理员显式恢复）
# SNAPSHOT_PAUSE_TTL_SECONDS=0

# 上传文件归档总量上限（字节，默认 2GB）；超过则跳过剩余文件并在快照里记录提示
# SNAPSHOT_MAX_FILE_BYTES=2147483648

# 单次快照打包下载上限（字节，默认 256MB）
# SNAPSHOT_DOWNLOAD_MAX_BYTES=268435456

# 日志查看器 nginx 公网监听端口（默认 8120）：deploy-linux.sh / update-from-github.sh
# 渲染 nginx 模板时 sed 替换 __LOG_VIEWER_PORT__ 占位符；缺失/非数字/越界
# （1-65535）一律回退 8120 并告警。同时主后端 /api/version 把它下发给前端，
# 拼接「系统设置 → 日志查看器」按钮的访问地址。
# 注意：daphne 实际绑定的内部端口是 127.0.0.1:8121（deploy/logviewer.service 模板硬编码），
# 与本变量无关——故意解耦，避免 nginx 与 daphne 同机抢端口。改本变量不会影响 8121。
LOG_VIEWER_PORT=8120

# 日志查看器「防直连」令牌共享密钥（与主后端共用同一 .env；主后端用它签发一次性令牌，
# 日志查看器用它校验。缺失时回退到 JWT_SECRET）。留空即可：deploy-linux.sh 首次部署会
# 自动生成强随机值（无论 .env.example 是否带默认值都会覆盖）。主后端与日志查看器必须读到
# 同一个值，否则令牌校验失败（403）。切勿使用弱默认值。
LOGVIEWER_SECRET_KEY=""

# ============================================================
# C2 阶段 1：SQLite 调优（《架构性运维约束整改简报.md》C2.3）
# ============================================================
# 改造前：journal_mode=delete、busy_timeout=5000（sqlite3 默认），写并发一高即
# "database is locked"。现在默认开 WAL + busy_timeout=20000，并由
# apps/common/db_pragmas.py 对**每条**新连接下发 PRAGMA（Django 5.0 的 sqlite3
# 后端没有 init_command，OPTIONS 只支持 sqlite3.connect 的形参，故必须两层）。
#
# ⚠️ WAL 依赖共享内存与文件锁：数据库必须放在**本地磁盘**（NFS / 网络盘 / 容器挂载卷上
#    可能不可用甚至损坏）。若现场 DB 在网络盘上，请设 SQLITE_JOURNAL_MODE=DELETE 关闭。
#
# 现场快速回退（两者一起设 = 功能与性能回到改造前的 C2 行为）：
#   SQLITE_TUNING_ENABLED=false   → 不下发任何 PRAGMA，并撤掉 OPTIONS["timeout"]（锁等待回到 5s）
#   AUDIT_HTTP_ERROR_MODE=all     → 每个 4xx/5xx 都落库（与改造前一致）
# ⚠️ 注意：journal_mode 是**库文件的持久属性**，改开关只能让新连接不再下发 PRAGMA，
#    已 WAL 化的 db.sqlite3 不会自动变回 delete。要连文件也回退，需停服后执行：
#      python -c "import sqlite3;c=sqlite3.connect('backend/db.sqlite3');print(c.execute('PRAGMA journal_mode=DELETE').fetchone());c.close()"
# SQLITE_TUNING_ENABLED=true
# SQLITE_JOURNAL_MODE=WAL
# SQLITE_SYNCHRONOUS=NORMAL
# SQLITE_BUSY_TIMEOUT_MS=20000
# SQLITE_WAL_AUTOCHECKPOINT=1000

# 审计降噪（同一批次）：改造前**每个 4xx/5xx 都写一行 AuditLog**，100 客户端 Wi-Fi 抖动时
# 401/403 会把写串行占满。业务写审计（log_write）**不受本开关影响**，永远落库。
#   all     = 与改造前一致（全部落库）
#   sampled = 5xx 全量落库；4xx 按采样率落库 + 始终写文件日志（默认）
#   off     = 4xx/5xx 都只写文件日志，不落库
# AUDIT_HTTP_ERROR_MODE=sampled
# AUDIT_HTTP_ERROR_SAMPLE_RATE=0.05
# 审计历史保留天数（manage.py audit_archive 默认值；建议加 cron/定时器每日执行）
# AUDIT_RETENTION_DAYS=7

# ============================================================
# C1-a：HTTP 与 WebSocket 进程分离（多 worker WSGI + 跨进程实时总线）
# ============================================================
# 部署拓扑（deploy/ 下两个 systemd 单元，由 deploy-linux.sh / update-from-github.sh 安装）：
#   gipfel.service       daphne ASGI  → 127.0.0.1:8000  ← nginx /socket.io/ 与回环直连
#   gipfel-wsgi.service  gunicorn WSGI → 127.0.0.1:8002  ← nginx /api/ 与 /admin/
# 多进程后，REST 进程里的实时广播必须经**跨进程总线**送达 daphne 进程的 socket 连接，
# 否则「改完数据前端不刷新」。二选一：
#   ① 默认（零额外依赖）：WSGI 进程把事件经回环 HTTP 转发给 daphne（hub），共享密钥由
#      LOGVIEWER_SECRET_KEY 派生，无需额外配置；
#   ② 推荐（更大规模/多机）：装 redis，填 REALTIME_REDIS_URL 并设 REALTIME_BUS=redis。
#
# REALTIME_BUS: auto(默认) | local(单进程老行为) | hub(daphne) | forward(WSGI) | redis
#   注意：这两个键由两个单元各自的 Environment= 提供默认值（hub / forward），
#   只有在 .env 里**显式**写了才会覆盖 —— 想让两端都走 Redis 就必须显式写 redis。
# REALTIME_BUS=redis
# REALTIME_REDIS_URL="redis://127.0.0.1:6379/0"
# hub 的内部转发地址（forward 模式的投递目标；默认由 unit 提供 http://127.0.0.1:8000）
# REALTIME_FORWARD_URL="http://127.0.0.1:8000"
# 单次内部转发超时（秒，默认 0.5；超时只丢该事件，绝不阻断业务请求）
# REALTIME_FORWARD_TIMEOUT=0.5
# 断线重连补发的环形缓冲长度（默认 5000）
# REALTIME_RING_MAX_LEN=5000

# WSGI（gunicorn）进程参数：由 deploy/gipfel-wsgi.service 读取（EnvironmentFile=.env 覆盖 unit 默认值）
# 并发上限 ≈ GIPFEL_WSGI_WORKERS × GIPFEL_WSGI_THREADS（gthread）。CPU 核数少时按 2~4 个 worker 起步。
# GIPFEL_WSGI_PORT=8002
# GIPFEL_WSGI_WORKERS=4
# GIPFEL_WSGI_THREADS=8
# GIPFEL_WSGI_TIMEOUT=120

# ============================================================
# C3：会话心跳条件请求
# ============================================================
# /api/auth/me 支持 ETag/If-None-Match（命中返回 304 空体）与 ?light=1 轻响应，
# 把 100 客户端 × 20s 的稳态心跳流量降下来。关闭后与改造前行为一致。
# AUTH_ME_CONDITIONAL_ENABLED=true
