# ===== Python / Django =====
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.venv/
venv/
env/
backend/.deps/
*.sqlite3
db.sqlite3
# SQLite WAL 边车文件（C2 阶段 1 开启 journal_mode=WAL 后必然出现）：纯运行时状态，绝不入库。
# 注意 `db.sqlite3` / `*.sqlite3` 两条**匹配不到** `db.sqlite3-wal` / `db.sqlite3-shm`，故需单列。
*.sqlite3-wal
*.sqlite3-shm

# 测试/验证脚本产生的临时目录（如 x18/x19 套件、前端打包验证）
.tmp/

# ===== Django 运行时目录（保留空目录，忽略生成内容）=====
# 注意：必须写成 `X/*` 而不是 `X/` —— 父目录被整体排除后，`!X/.gitkeep` 无法再把其中的文件纳入。
backend/uploads/*
!backend/uploads/.gitkeep
backend/logs/*
!backend/logs/.gitkeep
backend/staticfiles/
# 快照归档目录（apps.snapshots）：含整库数据与上传文件，绝不入库；
# 升级脚本（deploy-linux.sh / update-from-github.sh）已显式 --exclude snapshots 保留它
backend/snapshots/
# 快照单测使用的临时归档目录
backend/snapshots_test_tmp/
# 本地验证用的数据库备份
backend/db.sqlite3.bak*

# ===== 密钥 / 环境配置 =====
.env
.env.*
!.env.example

# ===== Node / Vue (前端) =====
node_modules/
frontend/dist/
dist/
# 本地验证用临时构建目录（vite build --outDir .build-tmp）
frontend/.build-tmp/
# 生产构建产物（deploy-linux.sh / update-from-github.sh 复制到仓库根的 frontend-dist/）
frontend-dist/
.vite/
*.local
# vite 加载 vite.config.ts 时生成的临时编译文件，构建中断时会残留
vite.config.ts.timestamp-*.mjs
vite.config.js.timestamp-*.mjs

# ===== 验证用例的临时目录（TempDir 用；沙箱下偶尔清理失败会残留）=====
tests/fix_verify/watcher/.tmp/
tests/fix_verify/scripts/.tmp/

# ===== 日志（保留项目根 logs/ 空目录）=====
logs/*
!logs/.gitkeep
*.log

# ===== 开发期上传目录（保留空目录）=====
uploads/*
!uploads/.gitkeep

# ===== OS / 编辑器 =====
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
.workbuddy/

# ===== contract_watcher 测试产物 =====
# 保留 test_output/ 下的报告（*.md）与日志（logs/），只忽略每次运行生成的表格
contract_watcher/bookkeeping_example/test_output*/*.xlsx
contract_watcher/bookkeeping_example/test_output*/**/*.xlsx

# ===== contract_watcher 运行产物（审计 CW-26）=====
# 业务合同 JSON、进度文件与运行日志属本机产物：不应入库（含迁移/浸泡测试产生的存档）
contract_watcher/records/
contract_watcher/data/
contract_watcher/watcher.log
contract_watcher/handlers.py.bak
contract_watcher/handlers.py.tmp
contract_watcher/test_run*/records/
contract_watcher/test_run*/watcher.log
contract_watcher/test_run*/handlers.py.*

# ===== contract_watcher 新工作流产物（SQLite 分账 + 公司账本 + 本地配置）=====
# data/ 已覆盖 watcher.db*（WAL 的 -wal/-shm 同目录）；账本含真实业务数据，配置可能含密码。
contract_watcher/books/
contract_watcher/config.json
contract_watcher/config.json.tmp
contract_watcher/**/*.xlsx.bak*
contract_watcher/bookkeeping_example/no-such.xlsx

# ===== 中间过程产物（2026-09 基线整理：结论性文档已归档，产物不再入库）=====
# 审计/探针取证工作目录：只放临时产物（before/after 代码快照、patch/harness、运行输出）。
# 结论性报告已归档至 docs/audit/ —— 见 docs/audit/README.md 的「归档说明」。
code_audit/
# 独立验收套件的原始运行日志（可用 tests/ops_check/run_all.cmd 原样重跑再生）
tests/ops_check/_artifacts/
# 分支差异的机器生成 diff（数百 KB ~ 数 MB，可用 docs/branch-diff/gen-report.ps1 重跑再生）
docs/branch-diff/*.diff
# 前端验证用例的 esbuild 打包产物
tests/fix_verify/frontend/.build/
# 临时链接检查/整理输出
.linkcheck-out.txt
.linkfix-out.txt
